# CAS ID eSign (BankHub). Production: https://production.bankhub.dev
CAS_ESIGN_BASE_URL=https://sandbox.bankhub.dev
CAS_ESIGN_CLIENT_ID=<client_id_do_cas_cap>
CAS_ESIGN_API_KEY=<api_key_do_cas_cap>

PORT=8787
# URL công khai của backend (domain thật, hoặc URL ngrok khi test trên máy).
PUBLIC_URL=
# Chuỗi ngẫu nhiên dài; nằm trong URL webhook khai báo ở CAS Console.
# Tạo bằng: openssl rand -hex 32
CAS_WEBHOOK_TOKEN=
# Tuỳ chọn: chỉ nhận webhook từ các IP này (sandbox CAS: 20.2.69.168). Để trống = không lọc.
CAS_WEBHOOK_ALLOWED_IPS=
# Origin của extension, cách nhau bằng dấu phẩy. Để trống = cho mọi chrome-extension:// (chỉ dùng khi dev).
EXTENSION_ORIGINS=
DATA_DIR=./data
RETENTION_DAYS=7
# Tuỳ chọn: file PEM chứa chứng thư gốc tin cậy (vd. Root CA quốc gia của Việt Nam) để xác minh
# chữ ký số trong PDF tới gốc. Để trống = vẫn kiểm tra chữ ký, OCSP, CRL nhưng báo "chưa xác minh tới gốc".
TRUSTED_CA_PEM_FILE=
